{
  "info": {
    "_postman_id": "b763c950-797d-56ce-9973-eb8e264a66fa",
    "name": "ChallengeAPI - Testes Automatizados (QA)",
    "description": "Parte B - Automação de Teste (FIAP 2TDS).\n\nTestes funcionais (status, contrato e regras dos endpoints Auth, Tutores e Pets) e não funcional (tempo de resposta em todas as requisições).\n\nExecutar em ordem pelo Collection Runner com o environment 'ChallengeAPI - Local'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Teste NÃO FUNCIONAL aplicado a todas as requisições (desempenho)",
          "// O CT00 só aquece a conexão com o banco, então fica fora da medição",
          "if (!pm.info.requestName.startsWith('CT00')) {",
          "    const limite = Number(pm.environment.get('tempoMaximoMs') || 2000);",
          "    pm.test(`Desempenho - tempo de resposta < ${limite} ms`, () => {",
          "        pm.expect(pm.response.responseTime).to.be.below(limite);",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0 - Pré-condição",
      "item": [
        {
          "name": "CT00 - Pré-condição: API e banco Oracle disponíveis",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json = {}; try { json = pm.response.json(); } catch (e) {}",
                  "pm.test('CT00 - API responde no /health (200)', () => pm.response.to.have.status(200));",
                  "pm.test('CT00 - Banco Oracle Healthy', () => pm.expect(json.status).to.eql('Healthy'));",
                  "// Sem banco não adianta seguir: interrompe a execução",
                  "if (json.status !== 'Healthy') { postman.setNextRequest(null); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Entrada: GET /health. Saída esperada: 200 e status Healthy. Se o Oracle estiver fora, a execução para aqui.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "1 - Autenticação (JWT)",
      "item": [
        {
          "name": "CT01 - Login com credenciais válidas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CT01 - Status 200 OK', () => pm.response.to.have.status(200));",
                  "let json = {}; try { json = pm.response.json(); } catch (e) { /* corpo não é JSON (ex.: erro 500) */ }",
                  "pm.test('CT01 - Retorna token JWT no corpo', () => {",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json.token.split('.')).to.have.lengthOf(3);",
                  "});",
                  "// guarda o token para as próximas requisições",
                  "if (json.token) pm.environment.set('token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Auth",
                "login"
              ]
            },
            "description": "Entrada: usuário admin + senha correta. Saída esperada: 200 e um JWT (3 partes separadas por ponto).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usuarioAdmin}}\",\n  \"password\": \"{{senhaAdmin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "CT02 - Login com senha inválida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CT02 - Status 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('CT02 - Não retorna token', () => pm.expect(pm.response.text()).to.not.include('token'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Auth",
                "login"
              ]
            },
            "description": "Entrada: senha 'senhaErrada123'. Saída esperada: 401 sem token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usuarioAdmin}}\",\n  \"password\": \"senhaErrada123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "CT03 - Rota protegida sem token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CT03 - Status 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/Auth/dados-protegidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Auth",
                "dados-protegidos"
              ]
            },
            "description": "Entrada: nenhuma autenticação. Saída esperada: 401.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "CT04 - Rota protegida com token válido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CT04 - Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('CT04 - Mensagem identifica o usuário autenticado', () => {",
                  "    pm.expect(pm.response.json().message).to.include(pm.environment.get('usuarioAdmin'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/Auth/dados-protegidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Auth",
                "dados-protegidos"
              ]
            },
            "description": "Entrada: Bearer {{token}} obtido no CT01. Saída esperada: 200 e mensagem 'Olá admin! Você está autenticado.'",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
