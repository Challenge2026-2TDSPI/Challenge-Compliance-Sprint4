                  "pm.test('CT05 - Status 201 Created', () => pm.response.to.have.status(201));",
                  "let json = {}; try { json = pm.response.json(); } catch (e) { /* corpo não é JSON (ex.: erro 500) */ }",
                  "pm.test('CT05 - Gera ID numérico', () => pm.expect(json.id).to.be.a('number').and.above(0));",
                  "pm.test('CT05 - Dados retornados iguais aos enviados', () => {",
                  "    pm.expect(json.nome).to.eql('Tutor QA Automacao');",
                  "    pm.expect(json.telefone).to.eql('11999990000');",
                  "    pm.expect(json.email).to.eql('tutor.qa@petcare.com');",
                  "});",
                  "pm.test('CT05 - Header Location aponta para o recurso criado', () => {",
                  "    pm.expect(pm.response.headers.get('Location')).to.include('/api/Tutores/' + json.id);",
                  "});",
                  "if (json.id) pm.environment.set('tutorId', json.id);"
                ]
              }
            }
